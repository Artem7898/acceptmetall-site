[Unit]
Description=Acceptmetall durable order API and notification queue
After=network-online.target clamav-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=acceptmetall
Group=acceptmetall
WorkingDirectory=/opt/acceptmetall-site
Environment=NODE_ENV=production
EnvironmentFile=/etc/acceptmetall/orders.env
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
StateDirectory=acceptmetall
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/acceptmetall
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
