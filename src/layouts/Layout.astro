---
import { t, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t[lang];

const otherLang: Lang = lang === 'ru' ? 'en' : 'ru';
const BASE_URL = import.meta.env.BASE_URL;

const homePath = `${BASE_URL}`;
const otherPath = lang === 'ru' ? `${BASE_URL}en/` : `${BASE_URL}`;

const ruCanonical = new URL(BASE_URL, Astro.site);
const enCanonical = new URL(`${BASE_URL}en/`, Astro.site);
const canonicalUrl = lang === 'ru' ? ruCanonical : enCanonical;

const faviconUrl = `${BASE_URL}favicon.svg`;

// === Structured Data (Schema.org) ===
const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: lang === 'ru' ? 'ООО Акцепт-2' : 'LLC Akcept-2',
  url: canonicalUrl.toString(),
  logo: new URL(`${BASE_URL}favicon.svg`, Astro.site).toString(),
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+7-904-551-17-63',
      contactType: 'sales',
      areaServed: 'RU',
      availableLanguage: ['Russian', 'English'],
    },
  ],
  sameAs: [],
};


---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <meta name="description" content={tr.meta.description} />
  <meta name="author" content={lang === 'ru' ? 'ООО Акцепт-2' : 'LLC Akcept-2'} />

  <!-- Open Graph -->
  <meta property="og:title" content={tr.meta.title} />
  <meta property="og:description" content={tr.meta.description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl.toString()} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={tr.meta.title} />
  <meta name="twitter:description" content={tr.meta.description} />

  <!-- Canonical & Hreflang -->
  <link rel="canonical" href={canonicalUrl.toString()} />
  <link rel="alternate" hreflang="ru" href={ruCanonical.toString()} />
  <link rel="alternate" hreflang="en" href={enCanonical.toString()} />
  <link rel="alternate" hreflang="x-default" href={ruCanonical.toString()} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href={faviconUrl} />

  <!-- PWA Manifest -->
  <link rel="manifest" href="/manifest.json" />

  <!-- Theme color для мобильных браузеров -->
  <meta name="theme-color" content="#2563eb" />

  <title>{tr.meta.title}</title>

  <!-- === PERFORMANCE FIXES === -->

  <!-- 1. Preconnect к доменам шрифтов (убирает ~300-500мс блокировки) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- 3. Шрифты через <link> вместо @import в CSS (не блокирует парсинг) -->
  <!-- Убраны веса 300 и 900 — добавьте обратно, если используются -->
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    media="all"
  />

  <!-- 4. JSON-LD через set:html — серверная сериализация, чистый JSON в HTML -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)}></script>
</head>

<body>
  <slot />

  <div class="lang-switcher-fixed">
    <a
      href={otherPath}
      class="lang-btn"
      aria-label={`Switch to ${otherLang === 'ru' ? 'Russian' : 'English'}`}
    >
      {otherLang.toUpperCase()}
    </a>
  </div>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .lang-switcher-fixed {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 1001;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid var(--color-border, #ccc);
    border-radius: 50%;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-text, #333);
    text-decoration: none;
    box-shadow: var(--shadow, 0 2px 8px rgba(0, 0, 0, 0.1));
    transition: var(--transition, all 0.3s ease);
  }

  .lang-btn:hover {
    background: var(--color-accent, #007bff);
    color: white;
    border-color: var(--color-accent, #007bff);
  }
</style>