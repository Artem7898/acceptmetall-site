---
import { t, type Lang } from '../../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t[lang];

const otherLang: Lang =
  lang === 'ru' ? 'en' : 'ru';

const BASE_URL = import.meta.env.BASE_URL;

const otherPath =
  lang === 'ru'
    ? `${BASE_URL}en/`
    : BASE_URL;

const privacyPath =
  lang === 'ru'
    ? `${BASE_URL}privacy/`
    : `${BASE_URL}en/privacy/`;

const termsPath =
  lang === 'ru'
    ? `${BASE_URL}terms/`
    : `${BASE_URL}en/terms/`;
---

<footer class="footer">
  <div class="container">

    <div class="footer-grid">

      <div class="footer-brand">
        <div class="footer-logo">
          АКЦЕПТ-2
        </div>

        <p class="footer-tagline">
          {tr.footer.tagline}
        </p>
      </div>

      <div class="footer-links">

        <a href="#about">
          {tr.footer.links[0]}
        </a>

        <a href="#products">
          {tr.footer.links[1]}
        </a>

        <a href="#supplies">
          {tr.footer.links[2]}
        </a>

        <a href="#contact">
          {tr.footer.links[3]}
        </a>

        <a href={privacyPath}>
          {tr.footer.links[4]}
        </a>

        <a href={termsPath}>
          {lang === 'ru'
            ? 'Пользовательское соглашение'
            : 'Terms of Use'}
        </a>

      </div>

      <div class="footer-contacts">

        <div class="footer-contact">
          <span class="footer-label">
            ООО «Акцепт-2»
          </span>

          <a href="tel:+79045511763">
            +7 (904) 551-17-63
          </a>

          <a href="mailto:Fedor.fiberflex@gmail.com">
            Fedor.fiberflex@gmail.com
          </a>
        </div>

        <div class="footer-contact">
          <span class="footer-label">
            FIBERFLEX OÜ
          </span>

          <a href="tel:+37258190619">
            +372 58 190 619
          </a>

          <a href="mailto:Fedor.fiberflex@gmail.com">
            Fedor.fiberflex@gmail.com
          </a>
        </div>

      </div>
    </div>

    <div class="footer-bottom">

      <p>
        © 2026 ООО «Акцепт-2».
        {lang === 'ru'
          ? 'Все права защищены.'
          : 'All rights reserved.'}
      </p>

      <a
        href={otherPath}
        class="footer-lang"
        aria-label={`Switch to ${
          otherLang === 'ru'
            ? 'Russian'
            : 'English'
        }`}
      >
        {otherLang.toUpperCase()}
      </a>

    </div>
  </div>
</footer>

<style>
  .footer {
    background: #0a0f1d;
    color: rgba(255, 255, 255, 0.7);

    padding: 64px 0 32px;

    border-top:
      1px solid
      var(--color-border-dark);
  }

  .footer-grid {
    display: grid;

    grid-template-columns:
      1.5fr 2fr 2fr;

    gap: 48px;

    margin-bottom: 48px;
  }

  .footer-logo {
    font-size: 20px;
    font-weight: 800;

    color: white;

    letter-spacing: 0.05em;

    margin-bottom: 8px;
  }

  .footer-tagline {
    font-size: 13px;

    color: var(--color-steel);

    line-height: 1.5;
  }

  .footer-links {
    display: flex;
    flex-direction: column;

    gap: 10px;
  }

  .footer-links a {
    color:
      rgba(255, 255, 255, 0.7);

    text-decoration: none;

    font-size: 14px;

    transition: var(--transition);
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  .footer-contacts {
    display: flex;
    flex-direction: column;

    gap: 20px;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;

    gap: 4px;
  }

  .footer-label {
    font-size: 12px;
    font-weight: 600;

    text-transform: uppercase;
    letter-spacing: 0.05em;

    color: var(--color-steel);
  }

  .footer-contact a {
    color:
      rgba(255, 255, 255, 0.7);

    text-decoration: none;

    font-size: 14px;
  }

  .footer-contact a:hover {
    color: var(--color-accent);
  }

  .footer-bottom {
    display: flex;

    justify-content: space-between;
    align-items: center;

    padding-top: 24px;

    border-top:
      1px solid
      var(--color-border-dark);

    font-size: 13px;

    color: var(--color-steel);
  }

  .footer-lang {
    color:
      rgba(255, 255, 255, 0.7);

    text-decoration: none;

    font-weight: 700;

    font-size: 13px;
  }

  .footer-lang:hover {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .footer-bottom {
      flex-direction: column;

      gap: 12px;

      text-align: center;
    }
  }
</style>