---
import { t, type Lang } from '../../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t[lang];
---

<section class="benefits" id="benefits">
  <div class="container">
    <div class="benefits-header">
      <span class="section-label">{lang === 'ru' ? 'Преимущества' : 'Advantages'}</span>
      <h2 class="section-title">{tr.benefits.title}</h2>
    </div>
    <div class="benefits-grid">
      {tr.benefits.cards.map((card, i) => (
        <div class="benefit-card" style={`--delay: ${i * 0.1}s`}>
          <div class="benefit-num">0{i + 1}</div>
          <h3 class="benefit-title">{card.title}</h3>
          <p class="benefit-desc">{card.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .benefits {
    padding: 100px 0;
    background: var(--color-bg-light);
  }
  .benefits-header {
    text-align: center;
    margin-bottom: 64px;
  }
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .benefit-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 36px 28px;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
  }
  .benefit-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
    border-color: var(--color-accent-light);
  }
  .benefit-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--color-accent);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .benefit-card:hover::before {
    opacity: 1;
  }
  .benefit-num {
    font-size: 48px;
    font-weight: 900;
    color: var(--color-accent);
    opacity: 0.15;
    line-height: 1;
    margin-bottom: 16px;
  }
  .benefit-title {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--color-text);
  }
  .benefit-desc {
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .benefits-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
