# Server only. Never copy secrets to PUBLIC_* variables or commit real values.
NODE_ENV=production
ORDER_HOST=127.0.0.1
ORDER_PORT=8787
ORDER_DB_PATH=/var/lib/acceptmetall/orders.sqlite
ORDER_ALLOWED_ORIGINS=https://acceptmetall.ru
ORDER_TO=Fedor.fiberflex@gmail.com
# Verified sender for the selected SMTP service (not necessarily the recipient).
ORDER_FROM=
# Generate a random value: openssl rand -hex 32
ORDER_ADMIN_TOKEN=
ORDER_RETENTION_DAYS=90
ORDER_RATE_LIMIT=10
# Only set when requests actually arrive from a private trusted reverse proxy.
ORDER_TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
